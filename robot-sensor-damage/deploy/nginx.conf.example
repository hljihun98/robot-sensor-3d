# /etc/nginx/sites-available/robot-sensor-damage  (도메인과 인증서 경로를 바꿔 쓰세요)
# HTTPS 인증서: sudo certbot --nginx -d damage.example.com
server {
    listen 80;
    server_name damage.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name damage.example.com;
    ssl_certificate     /etc/letsencrypt/live/damage.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/damage.example.com/privkey.pem;

    client_max_body_size 50m;   # 사진 여러 장 업로드

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
