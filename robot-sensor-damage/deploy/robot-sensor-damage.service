# /etc/systemd/system/robot-sensor-damage.service
# sudo systemctl daemon-reload && sudo systemctl enable --now robot-sensor-damage
[Unit]
Description=Robot sensor damage history server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/srv/robot-sensor-damage
EnvironmentFile=/srv/robot-sensor-damage/.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/app.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
