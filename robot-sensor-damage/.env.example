# 서버 설정 예시 — 복사해서 .env 로 쓰거나 systemd/docker 환경 변수로 넣으세요.
PORT=3000
HOST=127.0.0.1
# 데이터(DB·사진·백업) 폴더. 기본: 프로젝트/data
DATA_DIR=./data
# 날짜 기준 시간대
APP_TZ=Asia/Seoul
# 로그인 유지 기간(일)
SESSION_DAYS=30
# Nginx 등 프록시 뒤에서 HTTPS로 서비스할 때 1
TRUST_PROXY=1
# 첫 실행 때 만들 시스템 관리자 임시 비밀번호(8자 이상. 비우면 무작위로 만들어 화면에 출력)
INIT_ADMIN_PASSWORD=
# 사진 한 장 최대 크기(MB)
MAX_PHOTO_MB=8
