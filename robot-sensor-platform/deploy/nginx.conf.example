# Replace sensorlog.example.com and provision the TLS certificate before enabling.
server {
    listen 80;
    server_name sensorlog.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name sensorlog.example.com;
    ssl_certificate /etc/letsencrypt/live/sensorlog.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sensorlog.example.com/privkey.pem;
    client_max_body_size 65m;
    location / {
        proxy_pass http://127.0.0.1:3210;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 90s;
    }
    # Photos are served through the authenticated API. Do not alias data/photos.
}
